meta {
  name: Update By ID
  type: http
  seq: 7
}

put {
  url: {{localstackBaseUrl}}/calculations/{{id}}
  body: json
  auth: inherit
}

body:json {
  {
    "email": "harout@solidbeans.com",
    "client_name": "Updatingsss",
    "hourly_rate": 1050,
    "hours_worked": 160,
    "invoiced_amount": 128000,
    "after_deduction": 102400,
    "save_to_buffer": 10000,
    "gross_salary": 1,
    "total_costs": 1,
    "notes": "string",
    "date": "2025-12-22T12:12:12"
  }
}

script:post-response {
  let id = res.getBody().id
  bru.setEnvVar("id", id)
}

settings {
  encodeUrl: true
  timeout: 0
}
