meta {
  name: Create calculation
  type: http
  seq: 2
}

post {
  url: {{localstackBaseUrl}}/calculations
  body: json
  auth: inherit
}

body:json {
  {
    "email": "string",
    "client_name": "string",
    "hourly_rate": 1,
    "hours_worked": 160,
    "invoiced_amount": 1,
    "after_deduction": 1,
    "save_to_buffer": 1,
    "gross_salary": 1,
    "total_costs": 1,
    "notes": "string",
    "date": "2025-12-20T22:51:53.161Z",
    "created_at": "2025-12-20T22:51:53.161Z",
    "updated_at": "2025-12-20T22:51:53.161Z"
  }
}

script:post-response {
  let id = res.getBody().id
  let client_name = res.getBody().client_name
  bru.setEnvVar("id", id)
  bru.setEnvVar("client_name", client_name)
}

settings {
  encodeUrl: true
  timeout: 0
}
